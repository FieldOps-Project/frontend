# Copie este arquivo para .env.local e ajuste os valores.
#
# ATENCAO: apenas variaveis com o prefixo NEXT_PUBLIC_ sao embutidas no bundle
# enviado ao navegador. A URL interna da API e o segredo de sessao nunca podem
# ter esse prefixo -- o painel conversa com a API a partir do servidor do Next,
# e o token de sessao fica em cookie httpOnly, fora do alcance do JavaScript.

# ---------------------------------------------------------------------------
# Servidor -- nunca exposto ao navegador
# ---------------------------------------------------------------------------

# URL base da API REST, sem barra no final. Precisa ser alcancavel a partir do
# servidor do Next, e nao do navegador do usuario.
API_BASE_URL=http://localhost:8080/api/v1

# Segredo usado para assinar e validar o cookie de sessao.
SESSION_SECRET=troque-este-valor-em-cada-ambiente

# ---------------------------------------------------------------------------
# Navegador -- embutido no bundle em tempo de build
# ---------------------------------------------------------------------------

# Ambiente logico da build: development | staging | production.
# Serve apenas para a indicacao visual de ambiente exigida pelo documento 11.12.
NEXT_PUBLIC_APP_ENV=development
